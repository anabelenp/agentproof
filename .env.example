# Copy this file to .env and fill in your keys. Never commit .env.

# ── LLM API keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://localhost:5432/agentproof_test
# POSTGRES_POOL_SIZE=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_TTL_SECONDS=3600

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_LOG_DIR=./audit_logs

# ── Optional overrides ────────────────────────────────────────────────────────
# JUDGE_MODEL=claude-sonnet-4-6
# MAX_RETRIES=3
# MAX_RETRIEVAL_LATENCY_MS=500
# MAX_FALLBACK_SECONDS=5
# ROUTING_CONSISTENCY_DELTA=0.15
# MAX_DB_WRITE_LATENCY_MS=200
# TTL_TOLERANCE_SECONDS=5
# TOXICITY_THRESHOLD=0.1
# PII_REDACTION=true
