# Copy this file to .env and fill in your keys. Never commit .env.

# ── LLM API keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_LOG_DIR=./audit_logs

# ── Optional overrides ────────────────────────────────────────────────────────
# JUDGE_MODEL=claude-sonnet-4-6
# MAX_RETRIES=3
